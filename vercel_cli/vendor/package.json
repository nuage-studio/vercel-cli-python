{
  "bin": {
    "vc": "./dist/vc.js",
    "vercel": "./dist/vc.js"
  },
  "builders": {
    "@vercel/backends": "0.8.38",
    "@vercel/container": "0.2.0",
    "@vercel/elysia": "0.1.115",
    "@vercel/express": "0.1.129",
    "@vercel/fastify": "0.1.118",
    "@vercel/go": "3.11.0",
    "@vercel/h3": "0.1.124",
    "@vercel/hono": "0.2.118",
    "@vercel/hydrogen": "1.4.2",
    "@vercel/koa": "0.1.98",
    "@vercel/nestjs": "0.2.119",
    "@vercel/next": "4.21.6",
    "@vercel/node": "5.10.1",
    "@vercel/python": "6.57.1",
    "@vercel/redwood": "2.5.2",
    "@vercel/remix-builder": "5.9.5",
    "@vercel/ruby": "2.5.1",
    "@vercel/rust": "1.4.2",
    "@vercel/static-build": "2.12.7"
  },
  "dependencies": {
    "@vercel/build-utils": "14.1.1",
    "@vercel/detect-agent": "1.2.5",
    "@vercel/python": "6.57.1"
  },
  "description": "The command-line interface for Vercel",
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://vercel.com",
  "license": "Apache-2.0",
  "name": "vercel",
  "optionalDependencies": {
    "@vercel/vc-native-darwin-arm64": "59.1.3",
    "@vercel/vc-native-darwin-x64": "59.1.3",
    "@vercel/vc-native-linux-arm64": "59.1.3",
    "@vercel/vc-native-linux-x64": "59.1.3"
  },
  "preferGlobal": true,
  "repository": {
    "directory": "packages/cli",
    "type": "git",
    "url": "https://github.com/vercel/vercel.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build-binary": "node scripts/build-binary.mjs",
    "build-binary-node": "node scripts/build-binary-node.mjs",
    "build-binary:host": "node scripts/build-binary.mjs --target host --output ./dist-bin/vercel",
    "coverage": "codecov",
    "dev": "echo \"'pnpm dev [command]' has been removed. Use 'pnpm vercel [command]' instead.\" && exit 1",
    "smoke-binary": "node scripts/smoke-test-binary.mjs",
    "test": "node scripts/test.mjs --run",
    "test-dev": "vitest run --config ./vitest.config.mts test/dev/",
    "test-e2e": "node scripts/test.mjs --run test/e2e-",
    "test-e2e-node-all-versions": "rimraf test/fixtures/integration && vitest run --config ./vitest.config.mts test/integration-1.test.ts test/integration-2.test.ts test/integration-3.test.ts test/integration-link-env-pull.test.ts",
    "test-unit": "node scripts/test.mjs --run test/unit/",
    "test:evals": "tsx evals/run.ts",
    "test:evals:dry": "tsx evals/run.ts --dry",
    "test:evals:local-fixture": "tsx evals/run.ts --local-fixture",
    "test:evals:smoke": "tsx evals/run.ts smoke --smoke",
    "type-check": "tsc --noEmit",
    "vc": "pnpm vercel",
    "vercel": "pnpm build && node ./dist/vc.js"
  },
  "type": "module",
  "version": "59.1.3"
}
